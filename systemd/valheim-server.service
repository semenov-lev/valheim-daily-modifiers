[Unit]
Description=Valheim TSL Server
Wants=network-online.target
After=network-online.target

[Service]
User=steam
Group=steam
WorkingDirectory=/home/steam/Valheim-Server
EnvironmentFile=/home/steam/Valheim-Server/tg.env

# SteamCMD обновляет сервер перед каждым запуском
ExecStartPre=/usr/games/steamcmd +force_install_dir '/home/steam/Valheim-Server' +login anonymous +app_update 896660 validate +quit
TimeoutStartSec=900

# Обёртка: применяет комбинацию и exec сервера.
# Новая комбинация генерируется ТОЛЬКО при наличии маркера ротации
# (/run/valheim-rotate.flag, создаётся rotate.service). При любом другом
# старте (needrestart, ребут, ручной restart, падение) применяется уже
# сохранённая last_modifiers.json — сложность не меняется.
ExecStart=/home/steam/Valheim-Server/start_valheim.sh

# Уведомление в Telegram отправляет rotate.service (ExecStartPost) — только
# при реальной ротации. Здесь ExecStartPost убран, чтобы обновления libc и
# прочие внешние рестарты не слали лишние сообщения и не меняли сложность.
# КРИТИЧЕСКИ ВАЖНО: SIGINT → сохранение мира при остановке
KillSignal=SIGINT
TimeoutStopSec=120

Restart=on-abnormal
RestartSec=15

[Install]
WantedBy=multi-user.target
