# Токен бота и chat_id — обязательны
TG_BOT_TOKEN=123456789:AAExampleTokenReplaceMe
TG_CHAT_ID=-1001234567890

# SOCKS5-прокси. Схема socks5h:// ОБЯЗАТЕЛЬНА — её нужно дописать самим.
# Формат: socks5h://[user:pass@]host:port
#
# Без авторизации:
# TG_PROXY_URL=socks5h://142.25.125.255:31471
#
# С авторизацией:
TG_PROXY_URL=socks5h://user:password@142.25.125.255:31471
#
# Если в пароле есть @ : / ? # — percent-encode (например, @ → %40):
# TG_PROXY_URL=socks5h://user:p%40ss%3Aw0rd@142.25.125.255:31471
